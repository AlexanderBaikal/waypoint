{
  "name": "waypoint",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A map client for exploring points of interest, built on Leaflet and OpenStreetMap.",
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run format && npm run test",
    "fixtures": "node scripts/build-fixtures.mjs"
  },
  "dependencies": {
    "@fontsource/fraunces": "^4.5.0",
    "@fontsource/inter": "^4.5.0",
    "@reduxjs/toolkit": "^1.6.1",
    "@types/supercluster": "^5.0.3",
    "firebase": "^9.1.1",
    "leaflet": "^1.7.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-redux": "^7.2.5",
    "supercluster": "^7.1.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.15.1",
    "@testing-library/jest-dom": "^5.14.1",
    "@testing-library/react": "^12.1.1",
    "@testing-library/user-event": "^13.2.1",
    "@types/jest": "^27.0.2",
    "@types/leaflet": "^1.7.5",
    "@types/react": "^17.0.26",
    "@types/react-dom": "^17.0.9",
    "@typescript-eslint/eslint-plugin": "^4.32.0",
    "@typescript-eslint/parser": "^4.32.0",
    "@vitejs/plugin-react": "^1.0.1",
    "eslint": "^7.32.0",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-react-hooks": "^4.2.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^27.2.4",
    "jest-environment-jsdom": "^27.2.4",
    "prettier": "^2.4.1",
    "ts-jest": "^27.0.5",
    "typescript": "^4.4.3",
    "vite": "^2.6.2"
  }
}
